{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/blog",
      "destination": "/api/render-blog-list"
    },
    {
      "source": "/blog/",
      "destination": "/api/render-blog-list"
    },
    {
      "source": "/blog/:slug",
      "destination": "/api/render-blog?slug=:slug"
    },
    {
      "source": "/blog/:slug/",
      "destination": "/api/render-blog?slug=:slug"
    },
    {
      "source": "/api/blogs/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/api/blogs",
      "destination": "/api/index"
    },
    {
      "source": "/api/mcp/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/api/mcp",
      "destination": "/api/index"
    },
    {
      "source": "/api/health",
      "destination": "/api/index"
    },
    {
      "source": "/((?!assets/|favicon.ico|robots.txt|sitemap.xml|api/).*)",
      "destination": "/index.html"
    }
  ]
}